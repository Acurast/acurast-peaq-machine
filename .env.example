# ---------------------------------------------------------------------------
# Sent to the processor (listed in acurast.json "includeEnvironmentVariables").
# The Acurast CLI refuses to deploy if any listed key is missing or empty.
# Values are encrypted per processor; key names are public.
# ---------------------------------------------------------------------------

# Machine wallet. Create with `npm run owner keygen` (appends it to .env).
MACHINE_PRIVATE_KEY=
# mainnet | agung  (agung has no Economics 2.0 MCR / EventRegistry, see README)
PEAQ_NETWORK=mainnet
# Subscription tier 0 | 1 | 2 (mainnet bond ~0.48 / ~4.8 / ~954 PEAQ)
MACHINE_TIER=0
# Hard cap on the bond the processor may pay, in PEAQ
MAX_BOND_PEAQ=1

# ---------------------------------------------------------------------------
# Optional processor settings. To send one to the processor, also add it to
# includeEnvironmentVariables.
# ---------------------------------------------------------------------------
# MACHINE_TYPE=AcurastProcessor
# MACHINE_CREDENTIAL_SUBJECT=0x...    # default: hex("acurast:" + processor device address)
# MACHINE_MANUFACTURER=0x...          # default: machine wallet address
# PEAQOS_RPC_URL=
# EVENT_REGISTRY_ADDRESS=
# DRY_RUN=1                           # stop before any transaction
# WEBHOOK_URL=https://...             # every log line is also POSTed here as JSON

# ---------------------------------------------------------------------------
# Owner only: used by `npm run owner ...` on your computer.
# NEVER add OWNER_PRIVATE_KEY to includeEnvironmentVariables.
# ---------------------------------------------------------------------------
OWNER_PRIVATE_KEY=
# Extra PEAQ sent on top of the bond by `owner topup` to pay gas
# TOPUP_GAS_PEAQ=1

# ---------------------------------------------------------------------------
# Acurast CLI (read by `acurast deploy`, never sent to the processor)
# ---------------------------------------------------------------------------
# Deployer account. Optional if you sign in the browser instead (remote signing mode).
ACURAST_MNEMONIC=
# Defaults to Acurast's IPFS proxy, which needs no key.
# ACURAST_IPFS_URL=
# ACURAST_IPFS_API_KEY=
